# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@localhost:5432/ledger?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Optional email provider for magic links (any SMTP works)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Ledger <no-reply@ledger.local>"

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32 bytes base64. `openssl rand -base64 32`
# IMPORTANT: rotating this without re-wrapping existing DEKs will brick stored files.
MASTER_KEK=""

# ─── Object storage (Cloudflare R2 or any S3-compatible) ─────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ledger-statements"
R2_ENDPOINT=""   # e.g. https://<account>.r2.cloudflarestorage.com

# ─── OCR ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── FX ──────────────────────────────────────────────────────────────────────
FX_BASE="USD"

# ─── Cron protection ─────────────────────────────────────────────────────────
CRON_SECRET=""   # Vercel cron requests must carry `Authorization: Bearer <this>`

# ─── Bank connectors (Phase 2) ───────────────────────────────────────────────
# Enable Banking — PSD2 AIS via JWT-signed-with-private-key. Register at
# enablebanking.com, create an Application, generate a key pair, download the
# private key, copy the application_id.
ENABLE_BANKING_APP_ID=""
# Paste the contents of the .pem private key including the BEGIN/END lines.
# Vercel preserves multi-line values; escape as "\n" if your tooling can't.
ENABLE_BANKING_PRIVATE_KEY=""
# Where the user is redirected back to after consent. Must be public HTTPS.
# Defaults to <AUTH_URL>/api/banks/enablebanking/callback if unset.
ENABLE_BANKING_REDIRECT_URL=""

# GoCardless Bank Account Data — LEGACY. The provider closed to new signups;
# kept registered so existing connections (if any) keep syncing. New EU-bank
# connections use Enable Banking above. Leave blank unless you already had it.
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""
GOCARDLESS_REDIRECT_URL=""

# Public Ethereum RPC for the eth_address connector. Defaults to cloudflare-eth.com.
ETH_RPC_URL=""

# OpenFIGI API key (optional). Raises the rate limit on ISIN → ticker lookups.
# Free signup at https://www.openfigi.com/api. Without a key we still work, just slower.
OPENFIGI_API_KEY=""
